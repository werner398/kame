# Credenciales de Auth0 para la API de KAME ERP
# (te las dio quien te compartió el acceso a la API)
KAME_CLIENT_ID=tu_client_id_aqui
KAME_CLIENT_SECRET=tu_client_secret_aqui
KAME_AUDIENCE=https://api.kameone.cl/api
KAME_TOKEN_URL=https://api.kameone.cl/oauth/token
KAME_API_URL=https://api.kameone.cl/api

# Puerto en el que corre el backend (la nube suele asignarlo sola, déjalo así)
PORT=3000

# Usuario que queda registrado en KAME cuando este backend escribe cambios
# (KAME lo pide en el body de updArticulo, addArticulo, addInventario, etc.)
KAME_USUARIO_SISTEMA=dashboard@tuempresa.cl
